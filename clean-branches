#!/bin/bash

# Clean stale local git branches.
#
# Uses `git diff origin/develop...BRANCH` to detect branches whose changes
# are already in develop (works with squash merge, unlike `git branch --merged`).
#
# Flags:
#   -ai       Structured JSON output for AI agents
#   --dry-run List what would be deleted without deleting
#   --force   Delete without confirmation prompt
#
# Protected: develop, main, current branch (*), worktree branches (+)

set -e

AI_MODE=""
DRY_RUN=""
FORCE=""
TARGET="develop"

for arg in "$@"; do
  case "$arg" in
    -ai) AI_MODE="1" ;;
    --dry-run) DRY_RUN="1" ;;
    --force) FORCE="1" ;;
  esac
done

git fetch origin "$TARGET" --quiet 2>/dev/null

# Get protected branches: current (*), worktree (+), develop, main
PROTECTED=$(git branch | grep -E '^\*|^\+' | sed 's/^[* +]*//' | tr '\n' '|')
PROTECTED="${PROTECTED}develop|main"

EMPTY=()
TRIVIAL=()
ACTIVE=()

for branch in $(git branch | grep -v -E '^\*|^\+' | sed 's/^ *//' | grep -v -E "^(develop|main)$"); do
  files_changed=$(git diff "origin/$TARGET...$branch" --stat 2>/dev/null | grep -oE "^[[:space:]]*[0-9]+" | tr -d ' ' || echo "ERR")
  [ -z "$files_changed" ] && files_changed=0
  [ "$files_changed" = "ERR" ] && files_changed=0

  age=$(git log -1 --format="%cr" "$branch" 2>/dev/null)
  has_remote="no"
  git branch -r 2>/dev/null | grep -qw "origin/$branch" && has_remote="yes"

  if [ "$files_changed" -eq 0 ]; then
    EMPTY+=("$branch|$age|$has_remote")
  elif [ "$files_changed" -le 3 ]; then
    TRIVIAL+=("$branch|${files_changed} files|$age|$has_remote")
  else
    ACTIVE+=("$branch|${files_changed} files|$age|$has_remote")
  fi
done

if [ -n "$AI_MODE" ]; then
  # JSON output
  json_array() {
    local arr=("$@")
    echo -n "["
    for i in "${!arr[@]}"; do
      IFS='|' read -r name detail age remote <<< "${arr[$i]}"
      [ $i -gt 0 ] && echo -n ","
      echo -n "{\"branch\":\"$name\",\"detail\":\"$detail\",\"age\":\"$age\",\"remote\":\"$remote\"}"
    done
    echo -n "]"
  }

  echo -n "{\"empty_diff\":"
  json_array "${EMPTY[@]}"
  echo -n ",\"trivial\":"
  json_array "${TRIVIAL[@]}"
  echo -n ",\"active\":"
  json_array "${ACTIVE[@]}"
  echo "}"
else
  echo ""
  echo "=== Empty diff vs develop (safe to delete) ==="
  if [ ${#EMPTY[@]} -eq 0 ]; then
    echo "  (none)"
  else
    printf "  %-45s %-20s %s\n" "BRANCH" "AGE" "REMOTE"
    for entry in "${EMPTY[@]}"; do
      IFS='|' read -r name age remote <<< "$entry"
      printf "  %-45s %-20s %s\n" "$name" "$age" "$remote"
    done
  fi

  echo ""
  echo "=== Trivial diff (<=3 files) ==="
  if [ ${#TRIVIAL[@]} -eq 0 ]; then
    echo "  (none)"
  else
    printf "  %-45s %-12s %-20s %s\n" "BRANCH" "DIFF" "AGE" "REMOTE"
    for entry in "${TRIVIAL[@]}"; do
      IFS='|' read -r name diff age remote <<< "$entry"
      printf "  %-45s %-12s %-20s %s\n" "$name" "$diff" "$age" "$remote"
    done
  fi

  echo ""
  echo "=== Active work ==="
  if [ ${#ACTIVE[@]} -eq 0 ]; then
    echo "  (none)"
  else
    printf "  %-45s %-12s %-20s %s\n" "BRANCH" "DIFF" "AGE" "REMOTE"
    for entry in "${ACTIVE[@]}"; do
      IFS='|' read -r name diff age remote <<< "$entry"
      printf "  %-45s %-12s %-20s %s\n" "$name" "$diff" "$age" "$remote"
    done
  fi
fi

# Delete empty-diff branches
if [ ${#EMPTY[@]} -gt 0 ] && [ -z "$DRY_RUN" ]; then
  if [ -z "$FORCE" ] && [ -z "$AI_MODE" ]; then
    echo ""
    read -p "Delete ${#EMPTY[@]} empty-diff branches? [y/N] " confirm
    [ "$confirm" != "y" ] && [ "$confirm" != "Y" ] && exit 0
  fi

  for entry in "${EMPTY[@]}"; do
    IFS='|' read -r name _ _ <<< "$entry"
    git branch -D "$name" 2>/dev/null
    [ -z "$AI_MODE" ] && echo "  Deleted: $name"
  done
fi
