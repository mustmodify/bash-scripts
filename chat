#!/usr/bin/env bash
# Usage: chat SENDER "message"
# Usage: chat SENDER "line 1" "line 2" ...
# Usage: chat SENDER   (message read from stdin instead -- see note below)
#
# Posts a message to the shared agent chat log.
# SENDER: DEV-1, DEV-2, IM, JW, SYSTEM, etc.
#
# Examples:
#   chat JW "Hey agents, please rebase on develop"
#   chat DEV-1 "Starting work on X" "No conflicts expected"
#   printf 'a line with a literal `backtick` in it\n' | chat DEV-1
#
# Security note: a message passed as a shell argument is only as safe as its
# own quoting. `chat DEV-1 "$msg"` with $msg containing backticks/$() is a
# command injection -- the OUTER shell parses and executes that BEFORE this
# script ever runs; nothing in here can defend against it after the fact.
# If a message might contain content you didn't type yourself (relayed
# Slack/GitHub text, etc.), pipe it in via stdin instead: stdin bytes are
# never re-parsed for command substitution, so backticks/$() in them are
# just literal characters.

set -euo pipefail

CHAT="${HOME}/projects/earlyasset/ea-tools/chat.txt"
LOCK=/tmp/ea-chat.lock

if [ $# -lt 1 ]; then
  echo "Usage: chat SENDER \"message\" [\"line 2\" ...]" >&2
  echo "       chat SENDER   (message read from stdin instead)" >&2
  exit 1
fi

SENDER="$1"
shift

MESSAGES=("$@")
if [ "${#MESSAGES[@]}" -eq 0 ]; then
  if [ -t 0 ]; then
    echo "chat: no message given and stdin is a terminal -- pass a message argument or pipe one in" >&2
    exit 1
  fi
  mapfile -t MESSAGES < <(cat)
  if [ "${#MESSAGES[@]}" -eq 0 ]; then
    echo "chat: stdin was empty" >&2
    exit 1
  fi
fi

TS=$(date "+%Y-%m-%d %H:%M:%S")
PREFIX="[$TS] [$SENDER] "
INDENT=$(printf "%${#PREFIX}s" "")

# Build the lines to write, then atomic-append with flock
LINES=""
FIRST=1
for msg in "${MESSAGES[@]}"; do
  if [ "$FIRST" = "1" ]; then
    LINES="${PREFIX}${msg}"$'\n'
    FIRST=0
  else
    LINES="${LINES}${INDENT}${msg}"$'\n'
  fi
done

(
  flock 9
  printf '%s' "$LINES" >> "$CHAT"
  LINE_COUNT=$(wc -l < "$CHAT")
  if [ "$LINE_COUNT" -gt 500 ]; then
    ARCHIVE="${HOME}/projects/earlyasset/ea-tools/chat.$(date "+%Y%m%d%H%M%S").txt"
    mv "$CHAT" "$ARCHIVE"
    echo "[$TS] [SYSTEM] Chat archived to $(basename "$ARCHIVE")" >> "$CHAT"
  fi
) 9>"$LOCK"
