#!/bin/bash

# Check if the last argument is a directory
if [ -d "${!#}" ]; then
    dir="${!#}"
    args_length=$(( $# - 1 ))
else
    dir="."
    args_length=$#
fi

declare -A file_hits

while IFS= read -r -d $'\0' file; do
    total_hits=0
    for (( i=1; i<=args_length; i++ )); do
        word=${!i}
        count=$(grep -o "$word" "$file" | wc -l)
        if [ "$count" -gt 0 ]; then
            total_hits=$((total_hits + count))
        else
            total_hits=0
            break
        fi
    done

    if [ "$total_hits" -gt 0 ]; then
        file_hits["$file"]=$total_hits
    fi
done < <(find "$dir" -type f -print0)

# Sort the files by hits
for file in $(printf "%s\n" "${!file_hits[@]}" | sort -n -t_ -k2,2); do
    echo "$file ${file_hits[$file]}"
done

